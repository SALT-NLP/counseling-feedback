    "\n",
    "def binary_prediction_seeker_response_post(seeker, helper):\n",
    "    # sample = f\"Seeker: {seeker}\\nHelper: {helper}\"\n",
    "    sample = f\"Seeker: {seeker}[SEP]Helper: {helper}\"\n",
    "    \n",
    "    pred = classifier(sample)\n",
    "    return int(pred[0]['label'] == 'selected')"
   ]
